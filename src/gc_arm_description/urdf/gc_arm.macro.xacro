<?xml version="1.0"?>
<!--
  GC 6축 로봇팔 기구 (Standard DH → URDF)

  | J | a     | alpha | d    | theta     |
  | 1 | r     | +90   | h    | q1        |
  | 2 | a2    | 0     | 0    | q2        |
  | 3 | 0     | +90   | 0    | q3 + 90   |
  | 4 | 0     | -90   | d4   | q4        |
  | 5 | 0     | +90   | 0    | q5        |
  | 6 | 0     | 0     | d6   | q6        |

  형상: config/meshes.yaml에 등록된 링크는 CAD STL(visual) + 볼록 껍질(collision),
  나머지는 단순 도형. 메시 배치는 scripts/compute_mesh_origins.py로 계산.

  변환: 관절 i는 자기 프레임의 z축으로 회전. DH 행 i의 상수부 Tz(d)·Tx(a)·Rx(alpha)는
  다음 관절(i+1)의 origin(xyz="a 0 d", rpy="alpha 0 0")으로 들어간다.
  J3의 theta 오프셋(+90°)은 J4 origin의 회전 Rz(90°)·Rx(90°) = rpy(90°, 0, 90°)로 처리.
  tool0 = DH 프레임 6 (플랜지).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="gc_dark"><color rgba="0.2 0.2 0.22 1.0"/></material>
  <material name="gc_blue"><color rgba="0.15 0.45 0.8 1.0"/></material>
  <material name="gc_orange"><color rgba="0.95 0.55 0.15 1.0"/></material>
  <material name="gc_table"><color rgba="0.55 0.45 0.35 0.35"/></material>
  <material name="gc_grey"><color rgba="0.75 0.77 0.8 1.0"/></material>

  <!-- 링크: meshes.yaml에 메시가 있으면 STL, 없으면 블록으로 받은 단순 도형 -->
  <xacro:macro name="gc_link" params="name prefix M scale **shapes">
    <link name="${prefix}${name}">
      <xacro:if value="${name in M}">
        <xacro:property name="m" value="${M[name]}"/>
        <visual>
          <origin xyz="${m['xyz'][0]} ${m['xyz'][1]} ${m['xyz'][2]}" rpy="${m['rpy'][0]} ${m['rpy'][1]} ${m['rpy'][2]}"/>
          <geometry>
            <mesh filename="package://gc_arm_description/meshes/visual/${m['visual']}" scale="${scale} ${scale} ${scale}"/>
          </geometry>
          <material name="gc_grey"/>
        </visual>
        <xacro:if value="${m['collision'] is not None}">
          <collision>
            <origin xyz="${m['xyz'][0]} ${m['xyz'][1]} ${m['xyz'][2]}" rpy="${m['rpy'][0]} ${m['rpy'][1]} ${m['rpy'][2]}"/>
            <geometry>
              <mesh filename="package://gc_arm_description/meshes/collision/${m['collision']}" scale="${scale} ${scale} ${scale}"/>
            </geometry>
          </collision>
        </xacro:if>
      </xacro:if>
      <xacro:unless value="${name in M}">
        <xacro:insert_block name="shapes"/>
      </xacro:unless>
    </link>
  </xacro:macro>

  <xacro:macro name="gc_limit" params="j">
    <limit lower="${radians(j['lower_deg'])}" upper="${radians(j['upper_deg'])}"
           velocity="${radians(j['max_velocity_deg_s'])}" effort="${j['effort_nm']}"/>
  </xacro:macro>

  <xacro:macro name="gc_arm" params="cfg meshes:=None table_size:=1.0 prefix:=''">
    <xacro:property name="M" value="${meshes['links'] if meshes else dict()}"/>
    <xacro:property name="mesh_scale" value="${meshes['cad']['scale'] if meshes else 1.0}"/>
    <xacro:property name="g" value="${cfg['geometry']}"/>
    <xacro:property name="J" value="${cfg['joints']}"/>
    <xacro:property name="base_len" value="${max(g['h'], 0.02)}"/>

    <xacro:gc_link name="base_link" prefix="${prefix}" M="${M}" scale="${mesh_scale}">
      <shapes>
      <visual>
        <origin xyz="0 0 ${base_len / 2}"/>
        <geometry><cylinder radius="0.07" length="${base_len}"/></geometry>
        <material name="gc_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_len / 2}"/>
        <geometry><cylinder radius="0.07" length="${base_len}"/></geometry>
      </collision>
      </shapes>
    </xacro:gc_link>

    <!-- J1: 베이스 회전 -->
    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint1']}"/>
    </joint>
    <xacro:gc_link name="link1" prefix="${prefix}" M="${M}" scale="${mesh_scale}">
      <shapes>
      <visual>
        <origin xyz="${g['r']} 0 ${g['h']}"/>
        <geometry><sphere radius="0.05"/></geometry>
        <material name="gc_blue"/>
      </visual>
      <collision>
        <origin xyz="${g['r']} 0 ${g['h']}"/>
        <geometry><sphere radius="0.05"/></geometry>
      </collision>
      </shapes>
    </xacro:gc_link>

    <!-- J2: 어깨 -->
    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="${g['r']} 0 ${g['h']}" rpy="${pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint2']}"/>
    </joint>
    <xacro:gc_link name="link2" prefix="${prefix}" M="${M}" scale="${mesh_scale}">
      <shapes>
      <visual>
        <origin xyz="${g['a2'] / 2} 0 0" rpy="0 ${pi / 2} 0"/>
        <geometry><cylinder radius="0.035" length="${g['a2']}"/></geometry>
        <material name="gc_orange"/>
      </visual>
      <collision>
        <origin xyz="${g['a2'] / 2} 0 0" rpy="0 ${pi / 2} 0"/>
        <geometry><cylinder radius="0.035" length="${g['a2']}"/></geometry>
      </collision>
      </shapes>
    </xacro:gc_link>

    <!-- J3: 팔꿈치 -->
    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <origin xyz="${g['a2']} 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint3']}"/>
    </joint>
    <xacro:gc_link name="link3" prefix="${prefix}" M="${M}" scale="${mesh_scale}">
      <shapes>
      <visual>
        <geometry><sphere radius="0.045"/></geometry>
        <material name="gc_blue"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.045"/></geometry>
      </collision>
      </shapes>
    </xacro:gc_link>

    <!-- J4: 전완 축방향 회전 (J3 theta 오프셋 +90° 포함) -->
    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 ${pi / 2}"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint4']}"/>
    </joint>
    <xacro:gc_link name="link4" prefix="${prefix}" M="${M}" scale="${mesh_scale}">
      <shapes>
      <visual>
        <origin xyz="0 0 ${g['d4'] / 2}"/>
        <geometry><cylinder radius="0.03" length="${g['d4']}"/></geometry>
        <material name="gc_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${g['d4'] / 2}"/>
        <geometry><cylinder radius="0.03" length="${g['d4']}"/></geometry>
      </collision>
      </shapes>
    </xacro:gc_link>

    <!-- J5: 손목 굽힘 -->
    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <origin xyz="0 0 ${g['d4']}" rpy="${-pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint5']}"/>
    </joint>
    <xacro:gc_link name="link5" prefix="${prefix}" M="${M}" scale="${mesh_scale}">
      <shapes>
      <visual>
        <geometry><sphere radius="0.035"/></geometry>
        <material name="gc_blue"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.035"/></geometry>
      </collision>
      </shapes>
    </xacro:gc_link>

    <!-- J6: 플랜지 회전 -->
    <joint name="${prefix}joint6" type="revolute">
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint6']}"/>
    </joint>
    <xacro:gc_link name="link6" prefix="${prefix}" M="${M}" scale="${mesh_scale}">
      <shapes>
      <visual>
        <origin xyz="0 0 ${g['d6'] / 2}"/>
        <geometry><cylinder radius="0.03" length="${g['d6']}"/></geometry>
        <material name="gc_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${g['d6'] / 2}"/>
        <geometry><cylinder radius="0.03" length="${g['d6']}"/></geometry>
      </collision>
      </shapes>
    </xacro:gc_link>

    <!-- 작업대 상판 (base_link 바닥면 = z 0). MoveIt이 작업대를 관통하는 경로를 만들지 않도록 하는 충돌 전용 링크 -->
    <xacro:if value="${table_size > 0}">
      <joint name="${prefix}table_joint" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}table"/>
        <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      </joint>
      <link name="${prefix}table">
        <visual>
          <geometry><box size="${table_size} ${table_size} 0.02"/></geometry>
          <material name="gc_table"/>
        </visual>
        <collision>
          <geometry><box size="${table_size} ${table_size} 0.02"/></geometry>
        </collision>
      </link>
    </xacro:if>

    <!-- 플랜지 (DH 프레임 6) -->
    <joint name="${prefix}flange_joint" type="fixed">
      <parent link="${prefix}link6"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 ${g['d6']}" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}tool0"/>
  </xacro:macro>

</robot>
