<?xml version="1.0"?>
<!--
  GC 6축 로봇팔 기구 (Standard DH → URDF)

  | J | a     | alpha | d    | theta     |
  | 1 | r     | +90   | h    | q1        |
  | 2 | a2    | 0     | 0    | q2        |
  | 3 | 0     | +90   | 0    | q3 + 90   |
  | 4 | 0     | -90   | d4   | q4        |
  | 5 | 0     | +90   | 0    | q5        |
  | 6 | 0     | 0     | d6   | q6        |

  충돌 형상(collision)은 시각 형상과 동일한 단순 도형 (MoveIt 자기충돌 검사용, 실제 CAD로 교체 예정).

  변환: 관절 i는 자기 프레임의 z축으로 회전. DH 행 i의 상수부 Tz(d)·Tx(a)·Rx(alpha)는
  다음 관절(i+1)의 origin(xyz="a 0 d", rpy="alpha 0 0")으로 들어간다.
  J3의 theta 오프셋(+90°)은 J4 origin의 회전 Rz(90°)·Rx(90°) = rpy(90°, 0, 90°)로 처리.
  tool0 = DH 프레임 6 (플랜지).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="gc_dark"><color rgba="0.2 0.2 0.22 1.0"/></material>
  <material name="gc_blue"><color rgba="0.15 0.45 0.8 1.0"/></material>
  <material name="gc_orange"><color rgba="0.95 0.55 0.15 1.0"/></material>

  <xacro:macro name="gc_limit" params="j">
    <limit lower="${radians(j['lower_deg'])}" upper="${radians(j['upper_deg'])}"
           velocity="${radians(j['max_velocity_deg_s'])}" effort="${j['effort_nm']}"/>
  </xacro:macro>

  <xacro:macro name="gc_arm" params="cfg prefix:=''">
    <xacro:property name="g" value="${cfg['geometry']}"/>
    <xacro:property name="J" value="${cfg['joints']}"/>
    <xacro:property name="base_len" value="${max(g['h'], 0.02)}"/>

    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 ${base_len / 2}"/>
        <geometry><cylinder radius="0.07" length="${base_len}"/></geometry>
        <material name="gc_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_len / 2}"/>
        <geometry><cylinder radius="0.07" length="${base_len}"/></geometry>
      </collision>
    </link>

    <!-- J1: 베이스 회전 -->
    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint1']}"/>
    </joint>
    <link name="${prefix}link1">
      <visual>
        <origin xyz="${g['r']} 0 ${g['h']}"/>
        <geometry><sphere radius="0.05"/></geometry>
        <material name="gc_blue"/>
      </visual>
      <collision>
        <origin xyz="${g['r']} 0 ${g['h']}"/>
        <geometry><sphere radius="0.05"/></geometry>
      </collision>
    </link>

    <!-- J2: 어깨 -->
    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="${g['r']} 0 ${g['h']}" rpy="${pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint2']}"/>
    </joint>
    <link name="${prefix}link2">
      <visual>
        <origin xyz="${g['a2'] / 2} 0 0" rpy="0 ${pi / 2} 0"/>
        <geometry><cylinder radius="0.035" length="${g['a2']}"/></geometry>
        <material name="gc_orange"/>
      </visual>
      <collision>
        <origin xyz="${g['a2'] / 2} 0 0" rpy="0 ${pi / 2} 0"/>
        <geometry><cylinder radius="0.035" length="${g['a2']}"/></geometry>
      </collision>
    </link>

    <!-- J3: 팔꿈치 -->
    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <origin xyz="${g['a2']} 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint3']}"/>
    </joint>
    <link name="${prefix}link3">
      <visual>
        <geometry><sphere radius="0.045"/></geometry>
        <material name="gc_blue"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.045"/></geometry>
      </collision>
    </link>

    <!-- J4: 전완 축방향 회전 (J3 theta 오프셋 +90° 포함) -->
    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 ${pi / 2}"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint4']}"/>
    </joint>
    <link name="${prefix}link4">
      <visual>
        <origin xyz="0 0 ${g['d4'] / 2}"/>
        <geometry><cylinder radius="0.03" length="${g['d4']}"/></geometry>
        <material name="gc_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${g['d4'] / 2}"/>
        <geometry><cylinder radius="0.03" length="${g['d4']}"/></geometry>
      </collision>
    </link>

    <!-- J5: 손목 굽힘 -->
    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <origin xyz="0 0 ${g['d4']}" rpy="${-pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint5']}"/>
    </joint>
    <link name="${prefix}link5">
      <visual>
        <geometry><sphere radius="0.035"/></geometry>
        <material name="gc_blue"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.035"/></geometry>
      </collision>
    </link>

    <!-- J6: 플랜지 회전 -->
    <joint name="${prefix}joint6" type="revolute">
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <xacro:gc_limit j="${J['joint6']}"/>
    </joint>
    <link name="${prefix}link6">
      <visual>
        <origin xyz="0 0 ${g['d6'] / 2}"/>
        <geometry><cylinder radius="0.03" length="${g['d6']}"/></geometry>
        <material name="gc_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${g['d6'] / 2}"/>
        <geometry><cylinder radius="0.03" length="${g['d6']}"/></geometry>
      </collision>
    </link>

    <!-- 플랜지 (DH 프레임 6) -->
    <joint name="${prefix}flange_joint" type="fixed">
      <parent link="${prefix}link6"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 ${g['d6']}" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}tool0"/>
  </xacro:macro>

</robot>
