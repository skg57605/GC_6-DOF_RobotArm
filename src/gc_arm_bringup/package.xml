  <version>0.1.0</version>
  <description>Launch files and controller configuration for the GC 6-DOF arm.</description>
  <maintainer email="todo@example.com">skg57605</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gc_arm_description</exec_depend>
  <exec_depend>gc_arm_hardware</exec_depend>
